#!/bin/sh
# starts yoru's shell (aro's config and `rice` call this).
# aro gives children 1024 open files; quickshell wants more.
ulimit -n 65536
# with NVIDIA's driver installed but no NVIDIA card, glvnd still loads and
# initialises it beside Mesa (~90 MB for nothing): use Mesa alone
mesa=/usr/share/glvnd/egl_vendor.d/50_mesa.json
if [ ! -e /dev/nvidia0 ] && [ -f "$mesa" ] && [ -z "$__EGL_VENDOR_LIBRARY_FILENAMES" ]; then
	export __EGL_VENDOR_LIBRARY_FILENAMES="$mesa"
fi
# one render thread for all of the shell's windows instead of one each: ~55 MB
# less, and it felt no different on tux (2026-10-10). Set it yourself to override
export QSG_RENDER_LOOP="${QSG_RENDER_LOOP:-basic}"
exec qs -n -c yoru -d "$@"
