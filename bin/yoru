separator-color=00000000
text-color={c['on_surface']}ff
key-hl-color={c['primary']}ff
bs-hl-color={c['tertiary']}ff
caps-lock-key-hl-color={c['tertiary']}ff
caps-lock-bs-hl-color={c['error']}ff

ring-ver-color={c['primary']}ff
inside-ver-color={c['primary_container']}cc
text-ver-color={c['on_primary_container']}ff
line-ver-color=00000000

ring-wrong-color={c['error']}ff
inside-wrong-color={c['surface_container_lowest']}cc
text-wrong-color={c['error']}ff
line-wrong-color=00000000

ring-clear-color={c['secondary']}ff
inside-clear-color={c['surface_container_lowest']}b3
text-clear-color={c['on_surface']}ff
line-clear-color=00000000
""")


def btop(c):
    a = c["ansi"]
    keys = {
        "main_bg": "", "main_fg": c["on_surface"], "title": c["on_surface"], "hi_fg": c["primary"],
        "selected_bg": c["secondary_container"], "selected_fg": c["on_secondary_container"],
        "inactive_fg": c["outline"], "proc_misc": c["tertiary"], "graph_text": c["on_surface_variant"],
        "meter_bg": c["surface_container_highest"],
        "cpu_box": c["outline_variant"], "mem_box": c["outline_variant"], "net_box": c["outline_variant"],
        "proc_box": c["outline_variant"], "div_line": c["outline_variant"],
        "temp_start": c["primary"], "temp_mid": c["tertiary"], "temp_end": a[1],
        "cpu_start": c["primary"], "cpu_mid": c["tertiary"], "cpu_end": a[1],
        "free_start": c["primary_container"], "free_mid": c["primary"], "free_end": c["primary"],
        "cached_start": c["secondary_container"], "cached_mid": c["secondary"], "cached_end": c["secondary"],
        "available_start": c["tertiary_container"], "available_mid": c["tertiary"], "available_end": c["tertiary"],
        "used_start": c["primary"], "used_mid": c["tertiary"], "used_end": a[1],
        "download_start": c["primary_container"], "download_mid": c["primary"], "download_end": a[12],
        "upload_start": c["tertiary_container"], "upload_mid": c["tertiary"], "upload_end": a[13],
    }
    body = "\n".join(f'theme[{k}]="{"#" + v if v else ""}"' for k, v in keys.items())
    write(CONF / "btop/themes/yoru.theme", f"# generated by yoru\n\n{body}\n")
    path = CONF / "btop/btop.conf"
    if path.exists():
        write(path, re.sub(r'^color_theme = ".*"$', 'color_theme = "yoru"', path.read_text(), flags=re.M))


def cava(c):
    write(CONF / "cava/themes/yoru", f"""# generated by yoru
[color]
gradient = 1
gradient_color_1 = '#{c['primary_container']}'
gradient_color_2 = '#{c['primary']}'
gradient_color_3 = '#{c['tertiary']}'
""")
    path = CONF / "cava/config"
    if path.exists():
        write(path, re.sub(r'^theme = ".*"$', 'theme = "yoru"', path.read_text(), flags=re.M))
    sh("pkill", "-USR2", "-x", "cava")


def starship(c):
    a = c["ansi"]
    cols = {
        "blue": c["primary"], "red": a[1], "green": a[2], "yellow": a[3], "cyan": a[6], "magenta": a[5],
        "white": c["on_surface"], "black": c["surface"], "rosewater": c["tertiary"], "flamingo": a[9],
        "pink": a[13], "mauve": c["tertiary"], "maroon": a[1], "peach": a[11], "teal": a[6], "sky": a[14],
        "sapphire": c["primary"], "lavender": c["secondary"], "text": c["on_surface"],
        "subtext1": c["on_surface_variant"], "subtext0": c["on_surface_variant"], "overlay2": c["outline"],
        "overlay1": c["outline"], "overlay0": c["outline_variant"], "surface2": c["surface_container_highest"],
        "surface1": c["surface_container_high"], "surface0": c["surface_container"],
        "base": c["surface"], "mantle": c["surface_container_low"], "crust": c["surface_container_lowest"],
        "accent": c["primary"],
    }
    block = "# >>> yoru\n[palettes.yoru]\n" + "".join(f'{k} = "#{v}"\n' for k, v in cols.items()) + "# <<< yoru\n"
    path = CONF / "starship.toml"
    if not path.exists():
        return
    s = path.read_text()
    s = re.sub(r'^palette = ".*"$', 'palette = "yoru"', s, count=1, flags=re.M)
    if "# >>> yoru" in s:
        s = re.sub(r"# >>> yoru.*?# <<< yoru\n", lambda m: block, s, flags=re.S)
    else:
        s = s.rstrip("\n") + "\n\n" + block
    write(path, s)


def fastfetch(c):
    path = CONF / "fastfetch/config.jsonc"
    try:
        cfg = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    cfg.setdefault("display", {})["color"] = {"keys": "#" + c["primary"], "title": "#" + c["tertiary"]}
    write(path, json.dumps(cfg, indent=2) + "\n")


# ── firefox ─────────────────────────────────────────────────────────────

HERE = Path(__file__).resolve().parent.parent
STARTPAGES = HOME / "startpages"
WAL = HOME / ".cache/wal/colors.json"


def firefox_profiles():
    """every Firefox profile that has been used, old and XDG locations"""
    import configparser
    found = []
    for root in (CONF / "mozilla/firefox", HOME / ".mozilla/firefox"):
        ini = configparser.ConfigParser()
        try:
            ini.read(root / "profiles.ini")
        except configparser.Error:
            continue
        for sec in ini.sections():
            if "Path" not in ini[sec]:
                continue
            d = Path(ini[sec]["Path"])
            d = d if d.is_absolute() else root / d
            if (d / "prefs.js").exists() and d.resolve() not in found:
                found.append(d.resolve())
    return found


def render(text, c):
    return re.sub(r"\{\{(\w+)\}\}", lambda m: str(c.get(m.group(1), "")), text)


def firefox_chrome(profile):
    """userChrome.css and userContent.css import rice.css, which names the rice that is
    on. The first time, the old files become kon's: kon.css and kon-content.css"""
    chrome = profile / "chrome"
    chrome.mkdir(exist_ok=True)
    for name, kon, rice in (("userChrome.css", "kon.css", "rice.css"),
                            ("userContent.css", "kon-content.css", "rice-content.css")):
        f = chrome / name
        if f.exists() and rice not in f.read_text():
            f.replace(chrome / (kon if not (chrome / kon).exists() else name + ".pre-yoru"))
        if not f.exists() or rice not in f.read_text():
            write(f, f"/* `rice` points {rice} at the rice that is on: kon or yoru */\n@import url(\"{rice}\");\n")
    user = profile / "user.js"
    pref = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    if pref not in (user.read_text() if user.exists() else ""):
        with open(user, "a") as fh:
            fh.write("\n// load chrome/userChrome.css and chrome/userContent.css\n" + pref + "\n")
    return chrome


def firefox(s, c):
    tpl = HERE / "config/firefox"
    if not tpl.is_dir():
        return
    p = dict(c, name=Path(s["wallpaper"]).name, user=os.environ.get("USER", ""))
    for profile in firefox_profiles():
        chrome = firefox_chrome(profile)
        write(chrome / "yoru.css", render((tpl / "yoru.css").read_text(), p))
        write(chrome / "yoru-content.css", render((tpl / "yoru-content.css").read_text(), p))
        write(chrome / "rice.css", '@import url("yoru.css");\n')
        write(chrome / "rice-content.css", '@import url("yoru-content.css");\n')
    # the start page, with the wallpaper beside it
    STARTPAGES.mkdir(exist_ok=True)
    img = still(s["wallpaper"])
    if img:
        sh("magick", img + "[0]", "-resize", "1920x1080^", "-quality", "85", str(STARTPAGES / "yoru-wall.jpg"))
    write(STARTPAGES / "yoru-start.html", render((tpl / "yoru-start.html").read_text(), p))
    # Firefox's side of it (mozilla.cfg loads this): empty address bar, typing into the page
    write(STARTPAGES / "chrome.js", (tpl / "chrome.js").read_text())
    cur = STARTPAGES / "current.html"
    if cur.is_symlink() or not cur.exists():
        cur.unlink(missing_ok=True)
        cur.symlink_to("yoru-start.html")
    pywal(c)


def pywal(c):
    """Pywalfox paints Firefox's theme from pywal's colours: background is color0,
    the accents color10 and color13, the text color15. The first write keeps
    whatever was there as colors.json.pre-yoru, for `rice kon` to put back"""
    a = c["ansi"]
    cols = {f"color{i}": "#" + a[i] for i in range(16)}
    cols.update(color0="#" + c["surface_container_low"], color8="#" + c["surface_container_high"],
                color10="#" + c["primary"], color13="#" + c["tertiary"],
                color7="#" + c["on_surface_variant"], color15="#" + c["on_surface"])
    data = {"wallpaper": c.get("still", ""), "alpha": "100",
            "special": {"background": "#" + c["surface_container_low"], "foreground": "#" + c["on_surface"],
                        "cursor": "#" + c["primary"]},
            "colors": cols}
    if WAL.exists() and "yoru" not in WAL.read_text() and not WAL.with_name("colors.json.pre-yoru").exists():
        shutil.copy(WAL, WAL.with_name("colors.json.pre-yoru"))
    data["yoru"] = True
    write(WAL, json.dumps(data, indent=2) + "\n")
    if shutil.which("pywalfox"):
        sh("pywalfox", "update")


def cursor(s):
    name = s.get("cursor")
    dirs = (HOME / ".local/share/icons", HOME / ".icons", Path("/usr/share/icons"))
    if not name or not any((d / name / "cursors").is_dir() for d in dirs):
        return
    path = CONF / "aro/config"
    if path.exists():
        t = path.read_text()
        t2 = re.sub(r"^(\s*cursor_theme\s*=\s*).*$", lambda m: m.group(1) + name, t, count=1, flags=re.M)
        if t2 != t:
            write(path, t2)
    for f in (CONF / "gtk-3.0/settings.ini", CONF / "gtk-4.0/settings.ini"):
        if f.exists():
            write(f, re.sub(r"^gtk-cursor-theme-name=.*$", "gtk-cursor-theme-name=" + name, f.read_text(), flags=re.M))
    sh("gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", name)


def dark():
    sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark")
    for f in (CONF / "gtk-3.0/settings.ini", CONF / "gtk-4.0/settings.ini"):
        if f.exists():
            write(f, re.sub(r"^gtk-application-prefer-dark-theme=.*$", "gtk-application-prefer-dark-theme=1",
                            f.read_text(), flags=re.M))


def wallpaper(s):
    # the shell draws the wallpaper; aropaper would only sit underneath it
    sh("aroctl", "wallpaper", "none")


def apply(s, apps=True):
    if not Path(s["wallpaper"]).is_file():
        s["wallpaper"] = DEFAULTS["wallpaper"]
    c = palette(s["wallpaper"], s["scheme"])
    shell(s, c)
    if apps and active():
        cursor(s)
        aro(c)
        wallpaper(s)
        foot(c)
        gtk(c)
        dark()
        fuzzel(c)
        swaylock(c)
        btop(c)
        cava(c)
        starship(c)
        fastfetch(c)
        firefox(s, c)
    return c


# ── lyrics ──────────────────────────────────────────────────────────────

LYRICS = CACHE / "lyrics"
# what videos and fan uploads add to a title that the song itself doesn't have
NOISE = re.compile(r"\s*[\[(][^\])]*(official|video|audio|lyric|visuali[sz]er|mv|hd|4k|remaster|slowed|sped|nightcore|reverb|speed)[^\])]*[\])]", re.I)
SPEED = re.compile(r"slowed|sped ?up|speed ?up|nightcore", re.I)


def lrc(text):
    """[mm:ss.xx] lines → [[seconds, line], …], blank lines kept as breathing room"""
    out = []
    for raw in text.splitlines():
        stamps = re.findall(r"\[(\d+):(\d+(?:\.\d+)?)\]", raw)
        line = re.sub(r"\[[^\]]*\]", "", raw).strip()
        for m, sec in stamps:
            out.append([round(int(m) * 60 + float(sec), 2), line])
    return sorted(out, key=lambda x: x[0])


def lyrics(title, artist, length):
    """synced lyrics for what's playing. mpv names YouTube uploads "Artist - Title
    [Official Video]" with itself as the artist, so that gets untangled first.
    Nightcore and slowed uploads change the tempo: the original's timings are
    stretched to this version's length. Misses are remembered for a day."""
    import time
    import urllib.parse
    import urllib.request
    LYRICS.mkdir(parents=True, exist_ok=True)
    f = LYRICS / (hashlib.sha1(f"{title}\n{artist}".encode()).hexdigest()[:16] + ".json")
    try:
        cached = json.loads(f.read_text())
        if cached["lines"] or time.time() - cached["at"] < 86400:
            return cached["lines"]
    except (OSError, ValueError, KeyError):
        pass

    fast = bool(SPEED.search(title))
    # downloads keep their file name: an extension, and yt-dlp's [video id]
    title = re.sub(r"\.(webm|mkv|mp4|m4a|opus|ogg|mp3|flac|wav)$", "", title, flags=re.I)
    title = re.sub(r"\s*\[[A-Za-z0-9_-]{11}\]", "", title)
    t, a = NOISE.sub("", title).strip(), artist.strip()
    if a.lower() in ("", "mpv", "unknown", "unknown artist") or " - " in t:
        if " - " in t:
            a, t = (x.strip() for x in t.split(" - ", 1))
            t = NOISE.sub("", t).strip()
    a = re.sub(r"\s*-\s*topic$", "", a, flags=re.I)
    q = urllib.parse.quote
    urls = [] if fast or not length else [f"https://lrclib.net/api/get?track_name={q(t)}&artist_name={q(a)}&duration={int(length)}"]
    urls += [f"https://lrclib.net/api/search?track_name={q(t)}&artist_name={q(a)}",
             f"https://lrclib.net/api/search?q={q(t + ' ' + a)}"]
    found = None
    for url in urls:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "yoru (a quickshell rice)"})
            with urllib.request.urlopen(req, timeout=8) as r:
                d = json.loads(r.read())
        except Exception:
            continue
        for hit in (d if isinstance(d, list) else [d]):
            if hit and hit.get("syncedLyrics"):
                found = hit
                break
        if found:
            break
    lines = lrc(found["syncedLyrics"]) if found else []
    if lines and fast and length and found.get("duration"):
        k = float(length) / float(found["duration"])
        lines = [[round(sec * k, 2), line] for sec, line in lines]
    write(f, json.dumps({"at": time.time(), "lines": lines}))
    return lines


def main():
    args = sys.argv[1:] or ["apply"]
    s = state()
    cmd = args[0]
    if cmd == "apply":
        apply(s)
    elif cmd == "wall" and len(args) > 1:
        target = args[1]
        if target == "time" and len(args) > 2:
            fits = walls_for(s, args[2])
            if not fits:
                return 1
            if "--keep" in args and s["wallpaper"] in fits:
                return 0
            import random
            target = random.choice([w for w in fits if w != s["wallpaper"]] or fits)
        elif target in ("next", "prev", "random"):
            ws = walls(s)
            if not ws:
                return 1
            i = ws.index(s["wallpaper"]) if s["wallpaper"] in ws else -1
            if target == "random":
                import random
                target = random.choice([w for w in ws if w != s["wallpaper"]] or ws)
            else:
                target = ws[(i + (1 if target == "next" else -1)) % len(ws)]
        target = str(Path(os.path.expanduser(target)).resolve())
        if not Path(target).is_file():
            print(f"yoru: no such file: {target}", file=sys.stderr)
            return 1
        s["wallpaper"] = target
        save_state(s)
        apply(s)
    elif cmd == "walls":
        print(json.dumps([{"path": f, "thumb": thumb(f), "video": is_video(f), "name": Path(f).stem}
                          for f in walls(s)]))
    elif cmd == "timeline" and len(args) > 1:
        # worked out once per video, then handed to the shell if it's still the wallpaper
        timeline(args[1], s["scheme"])
        if s["wallpaper"] == args[1]:
            shell(s, palette(args[1], s["scheme"]))
    elif cmd == "art" and len(args) > 1:
        # a palette from album art, for the shell while the track plays
        c = art_palette(args[1], s["scheme"])
        if not c:
            return 1
        print(json.dumps(c))
    elif cmd == "lyrics" and len(args) > 2:
        print(json.dumps(lyrics(args[1], args[2], float(args[3]) if len(args) > 3 and args[3] else 0)))
    elif cmd == "restore":
        apply(s, apps=False)
        wallpaper(s)
    elif cmd == "status":
        print(s["wallpaper"])
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
