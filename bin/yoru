vertical-pad=16
inner-pad=10
line-height=26
prompt="  "

[colors]
background={c['surface_container']}f2
text={c['on_surface_variant']}ff
prompt={c['primary']}ff
placeholder={c['outline']}ff
input={c['on_surface']}ff
match={c['primary']}ff
selection={c['secondary_container']}ff
selection-text={c['on_secondary_container']}ff
selection-match={c['primary']}ff
counter={c['outline']}ff
border={c['outline_variant']}ff

[border]
width=1
radius=22
selection-radius=14
""")


