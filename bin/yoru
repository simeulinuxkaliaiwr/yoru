def starship(c):
    a = c["ansi"]
    cols = {
        "blue": c["primary"], "red": a[1], "green": a[2], "yellow": a[3], "cyan": a[6], "magenta": a[5],
        "white": c["on_surface"], "black": c["surface"], "rosewater": c["tertiary"], "flamingo": a[9],
        "pink": a[13], "mauve": c["tertiary"], "maroon": a[1], "peach": a[11], "teal": a[6], "sky": a[14],
        "sapphire": c["primary"], "lavender": c["secondary"], "text": c["on_surface"],
        "subtext1": c["on_surface_variant"], "subtext0": c["on_surface_variant"], "overlay2": c["outline"],
        "overlay1": c["outline"], "overlay0": c["outline_variant"], "surface2": c["surface_container_highest"],
        "surface1": c["surface_container_high"], "surface0": c["surface_container"],
        "base": c["surface"], "mantle": c["surface_container_low"], "crust": c["surface_container_lowest"],
        "accent": c["primary"],
    }
    block = "# >>> yoru\n[palettes.yoru]\n" + "".join(f'{k} = "#{v}"\n' for k, v in cols.items()) + "# <<< yoru\n"
    path = CONF / "starship.toml"
    if not path.exists():
        return
    s = path.read_text()
    s = re.sub(r'^palette = ".*"$', 'palette = "yoru"', s, count=1, flags=re.M)
    if "# >>> yoru" in s:
        s = re.sub(r"# >>> yoru.*?# <<< yoru\n", lambda m: block, s, flags=re.S)
    else:
        s = s.rstrip("\n") + "\n\n" + block
    write(path, s)


def fastfetch(c, s=None, m=None):
    path = CONF / "fastfetch/config.jsonc"
    try:
        cfg = json.loads(path.read_text())
    except (OSError, ValueError):
        return
    cfg.setdefault("display", {})["color"] = {"keys": "#" + c["primary"], "title": "#" + c["tertiary"]}
    if s is not None:
        logo = os.path.expanduser(m.get("fastfetch_logo", "")) if m else ""
        if logo and Path(logo).is_file():
            if "fastfetch_logo" not in s:
                s["fastfetch_logo"] = json.dumps(cfg.get("logo"))
                save_state(s)
            # the picture protocol the terminal was already shown with (sixel, kitty…), else fastfetch's guess
            was = json.loads(s["fastfetch_logo"]) or {}
            kind = was.get("type") if was.get("type") in ("sixel", "kitty", "kitty-direct", "iterm", "chafa") else "auto"
            cfg["logo"] = {"type": kind, "source": logo, "width": 26, "padding": {"top": 1, "right": 3}}
        elif "fastfetch_logo" in s:
            old = json.loads(s.pop("fastfetch_logo"))
            if old is None:
                cfg.pop("logo", None)
            else:
                cfg["logo"] = old
            save_state(s)
    write(path, json.dumps(cfg, indent=2) + "\n")


# firefox
HERE = Path(__file__).resolve().parent.parent
STARTPAGES = HOME / "startpages"
WAL = HOME / ".cache/wal/colors.json"


def firefox_profiles():
    """every Firefox profile that has been used, old and XDG locations"""
    import configparser
    found = []
    for root in (CONF / "mozilla/firefox", HOME / ".mozilla/firefox"):
        ini = configparser.ConfigParser()
        try:
            ini.read(root / "profiles.ini")
        except configparser.Error:
            continue
        for sec in ini.sections():
            if "Path" not in ini[sec]:
                continue
            d = Path(ini[sec]["Path"])
            d = d if d.is_absolute() else root / d
            if (d / "prefs.js").exists() and d.resolve() not in found:
                found.append(d.resolve())
    return found


def render(text, c):
    return re.sub(r"\{\{(\w+)\}\}", lambda m: str(c.get(m.group(1), "")), text)


def firefox_chrome(profile):
    """userChrome.css and userContent.css import rice.css, which names the theme that is
    on (a rice switcher can point it elsewhere). The first time, the old files are kept
    as userChrome.css.pre-yoru and userContent.css.pre-yoru"""
    chrome = profile / "chrome"
    chrome.mkdir(exist_ok=True)
    for name, rice in (("userChrome.css", "rice.css"), ("userContent.css", "rice-content.css")):
        f = chrome / name
        if f.exists() and rice not in f.read_text():
            f.replace(chrome / (name + ".pre-yoru"))
        if not f.exists() or rice not in f.read_text():
            write(f, f"/* {rice} names the theme that is on (yoru writes it) */\n@import url(\"{rice}\");\n")
    user = profile / "user.js"
    pref = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
    if pref not in (user.read_text() if user.exists() else ""):
        with open(user, "a") as fh:
            fh.write("\n// load chrome/userChrome.css and chrome/userContent.css\n" + pref + "\n")
    return chrome


def firefox(s, c):
    tpl = HERE / "config/firefox"
    if not tpl.is_dir():
        return
    p = dict(c, name=Path(s["wallpaper"]).name, user=os.environ.get("USER", ""))
    for profile in firefox_profiles():
        chrome = firefox_chrome(profile)
        write(chrome / "yoru.css", render((tpl / "yoru.css").read_text(), p))
        write(chrome / "yoru-content.css", render((tpl / "yoru-content.css").read_text(), p))
        write(chrome / "rice.css", '@import url("yoru.css");\n')
        write(chrome / "rice-content.css", '@import url("yoru-content.css");\n')
    # the start page, with the wallpaper beside it
    STARTPAGES.mkdir(exist_ok=True)
    img = still(s["wallpaper"])
    if img:
        sh("magick", img + "[0]", "-resize", "1920x1080^", "-quality", "85", str(STARTPAGES / "yoru-wall.jpg"))
    write(STARTPAGES / "yoru-start.html", render((tpl / "yoru-start.html").read_text(), p))
    # Firefox's side of it (mozilla.cfg loads this): empty address bar, typing into the page
    write(STARTPAGES / "chrome.js", (tpl / "chrome.js").read_text())
    cur = STARTPAGES / "current.html"
    if cur.is_symlink() or not cur.exists():
        cur.unlink(missing_ok=True)
        cur.symlink_to("yoru-start.html")
    pywal(c)


def pywal(c):
    """Pywalfox paints Firefox's theme from pywal's colours: background is color0,
    the accents color10 and color13, the text color15. The first write keeps
    whatever was there as colors.json.pre-yoru, to put back by hand"""
    a = c["ansi"]
    cols = {f"color{i}": "#" + a[i] for i in range(16)}
    cols.update(color0="#" + c["surface_container_low"], color8="#" + c["surface_container_high"],
                color10="#" + c["primary"], color13="#" + c["tertiary"],
                color7="#" + c["on_surface_variant"], color15="#" + c["on_surface"])
    data = {"wallpaper": c.get("still", ""), "alpha": "100",
            "special": {"background": "#" + c["surface_container_low"], "foreground": "#" + c["on_surface"],
                        "cursor": "#" + c["primary"]},
            "colors": cols}
    if WAL.exists() and "yoru" not in WAL.read_text() and not WAL.with_name("colors.json.pre-yoru").exists():
        shutil.copy(WAL, WAL.with_name("colors.json.pre-yoru"))
    data["yoru"] = True
    write(WAL, json.dumps(data, indent=2) + "\n")
    if shutil.which("pywalfox"):
        sh("pywalfox", "update")


def cursor(s, m=None):
    name = s.get("cursor")
    if m and m.get("cursor"):
        name = m["cursor"]
        own = Path(m["dir"]) / "cursor" / name
        link = HOME / ".local/share/icons" / name
        if (own / "cursors").is_dir() and not link.exists():
            link.parent.mkdir(parents=True, exist_ok=True)
            link.symlink_to(own)
    dirs = (HOME / ".local/share/icons", HOME / ".icons", Path("/usr/share/icons"))
    if not name or not any((d / name / "cursors").is_dir() for d in dirs):
        return
    path = CONF / "aro/config"
    if compositor() == "aro" and path.exists():
        t = path.read_text()
        t2 = re.sub(r"^(\s*cursor_theme\s*=\s*).*$", lambda m: m.group(1) + name, t, count=1, flags=re.M)
        if t2 != t:
            write(path, t2)
    for f in (CONF / "gtk-3.0/settings.ini", CONF / "gtk-4.0/settings.ini"):
        if f.exists():
            write(f, re.sub(r"^gtk-cursor-theme-name=.*$", "gtk-cursor-theme-name=" + name, f.read_text(), flags=re.M))
    sh("gsettings", "set", "org.gnome.desktop.interface", "cursor-theme", name)


def dark(c=None):
    """gtk's colour scheme: dark, or light for a light palette (a mode's)"""
    on = not (c and light(c))
    sh("gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark" if on else "prefer-light")
    for f in (CONF / "gtk-3.0/settings.ini", CONF / "gtk-4.0/settings.ini"):
        if f.exists():
            write(f, re.sub(r"^gtk-application-prefer-dark-theme=.*$", f"gtk-application-prefer-dark-theme={int(on)}",
                            f.read_text(), flags=re.M))


def wallpaper(s):
    # the shell or skwd draws the wallpaper; aropaper would only sit underneath it
    if compositor() == "aro":
        sh("aroctl", "wallpaper", "none")
    # (`yoru wall` sends it to skwd first, and what skwd picked itself is there already)
    if s.get("backend") == "skwd" and not s.get("skwd_has"):
        skwd_apply(s["wallpaper"])


# skwd-wall v2 as the wallpaper backend: its daemon (skwd-walld) draws the wallpaper
# and yoru keeps the colours. skwd-helm talks to the daemon; it exits 3 when none runs
SKWD_CONF = CONF / "skwd-wall-v2/config.json"
# skwd's settings that would fight yoru's: its own palette for the apps (yoru's
# stays: "Keep current colours"), a notification on every change, and a layer
# above yoru's widgets
SKWD_SETTINGS = {"theme": {"policy": "off"}, "general": {"notifyOnWallpaperChange": False},
                 "paper": {"wallpaperLayer": "background"}}


def skwd_ok():
    return shutil.which("skwd-helm") is not None and shutil.which("skwd-walld") is not None


def skwd_helm(*args):
    try:
        return subprocess.run(["skwd-helm", *args], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None


def skwd_setup():
    try:
        cfg = json.loads(SKWD_CONF.read_text())
    except (OSError, ValueError):
        cfg = {}
    old = json.dumps(cfg, sort_keys=True)
    for part, values in SKWD_SETTINGS.items():
        cfg.setdefault(part, {}).update(values)
    if json.dumps(cfg, sort_keys=True) != old:
        write(SKWD_CONF, json.dumps(cfg, indent=2) + "\n")
        SKWD_CONF.chmod(0o600)


def skwd_up():
    """the daemon running, started from here rather than as its user service: it then
    draws on this session's display. systemd's copy of WAYLAND_DISPLAY is whatever the
    last compositor to start put there (a nested or test one too), and skwd's renderers
    on a display that's gone fail with 'wayland setup'"""
    if skwd_stale():
        skwd_down()
    r = skwd_helm("current")
    if r and r.returncode != 3:
        return True
    if not os.environ.get("WAYLAND_DISPLAY"):
        return False
    subprocess.Popen(["skwd-walld", "--wait-for-session"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    import time
    for _ in range(50):
        time.sleep(0.2)
        r = skwd_helm("current")
        if r and r.returncode != 3:
            return True
    return False


def skwd_stale():
    """this session's daemon still running a program an update has since replaced:
    it keeps the old code until restarted (beta.17's drew transitions over the widgets)"""
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    for pid in subprocess.run(["pgrep", "-x", "skwd-walld"], capture_output=True, text=True).stdout.split():
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
            env = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        except OSError:
            continue
        if exe.endswith(" (deleted)") and f"XDG_RUNTIME_DIR={run}".encode() in env:
            return True
    return False


def skwd_down():
    # its renderers go with it (and the user service, if it was started that way)
    sh("systemctl", "--user", "stop", "skwd-walld.service")
    sh("pkill", "-x", "skwd-walld")


def skwd_apply(f, wait=True):
    """f on every screen, unless skwd already shows it there (it picked it itself).
    Not waiting: skwd's transition runs while yoru works out the colours"""
    if not Path(f).is_file():
        return
    if not skwd_ok() or not skwd_up():
        print("yoru: skwd-wall's daemon isn't running (is skwd-wall-v2 installed?)", file=sys.stderr)
        return
    r = skwd_helm("current", "--json")
    try:
        shown = [o.get("path") or "" for o in json.loads(r.stdout).get("outputs", []) if o.get("connected", True)]
    except (AttributeError, ValueError):
        shown = []
    if shown and all(p and Path(p).resolve() == Path(f).resolve() for p in shown):
        return
    if wait:
        skwd_helm("apply", f)
    else:
        subprocess.Popen(["skwd-helm", "apply", f], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def skwd_get():
    """what the settings window shows of skwd's: its config (None where skwd keeps its
    own default) and the sound, which the daemon keeps per screen"""
    try:
        cfg = json.loads(SKWD_CONF.read_text())
    except (OSError, ValueError):
        cfg = {}

    def at(path):
        v = cfg
        for k in path.split("."):
            if not isinstance(v, dict) or k not in v:
                return None
            v = v[k]
        return v
    out = {"installed": skwd_ok(), "running": False, "mute": True, "volume": 100}
    for k in ("transition.enabled", "transition.durationMs", "transition.shader", "transition.sandQuality",
              "general.randomRotate", "general.randomInterval", "schedule.enabled",
              "performance.batterySaver", "paper.idlePauseSeconds"):
        out[k] = at(k)
    r = skwd_helm("outputs", "--json") if out["installed"] else None
    if r and r.returncode == 0:
        out["running"] = True
        try:
            o = (json.loads(r.stdout).get("outputs") or [{}])[0]
            out["mute"], out["volume"] = bool(o.get("mute", True)), int(o.get("volume", 100))
        except (ValueError, TypeError, AttributeError):
            pass
    return out


def skwd_set(pairs):
    """settings, written the way skwd's own picker writes them (dotted paths into
    nested JSON), all at once; the daemon follows its config file"""
    try:
        cfg = json.loads(SKWD_CONF.read_text())
    except (OSError, ValueError):
        cfg = {}
    for path, value in pairs:
        try:
            v = json.loads(value)
        except ValueError:
            v = value
        *parents, last = path.split(".")
        node = cfg
        for k in parents:
            if not isinstance(node.get(k), dict):
                node[k] = {}
            node = node[k]
        node[last] = v
    write(SKWD_CONF, json.dumps(cfg, indent=2) + "\n")
    SKWD_CONF.chmod(0o600)


SKWD_CACHE = HOME / ".cache/skwd-wall-v2"


def skwd_scene_still(path):
    """a Wallpaper Engine scene has no picture yoru can read: skwd's thumbnail of it"""
    try:
        last = json.loads((SKWD_CACHE / "last-wallpaper.json").read_text())
        if last.get("thumb") and Path(last["thumb"]).is_file() and (last.get("path") == path or not path):
            return last["thumb"]
    except (OSError, ValueError):
        pass
    name = Path(path).name if path else ""
    for d in ("we-thumbs", "thumbs"):
        for f in sorted((SKWD_CACHE / d).glob(f"*{name}*")) if name else []:
            return str(f)
    return ""


def set_backend(s, name):
    if name not in ("yoru", "skwd"):
        print("yoru: the backend is yoru or skwd", file=sys.stderr)
        return 2
    if name == "skwd" and not skwd_ok():
        print("yoru: skwd-wall v2 isn't installed (skwd-wall-v2 and skwd-deck, from the AUR)", file=sys.stderr)
        return 1
    try:
        cfg = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        cfg = {}
    cfg.setdefault("wallpaper", {})["backend"] = name
    write(SETTINGS, json.dumps(cfg, indent=4) + "\n")
    s["backend"] = name
    if name == "skwd":
        skwd_setup()
        wallpaper(s)
    else:
        skwd_down()
    return 0


def night_sky(out):
    """yoru's own wallpaper for a first start: a soft aurora over a starry night"""
    out.parent.mkdir(parents=True, exist_ok=True)
    glow = lambda colour, ellipse, blur, alpha: [
        "(", "-size", "1920x1080", f"xc:{colour}", "(", "-size", "1920x1080", "xc:black", "-fill", "white",
        "-draw", f"ellipse {ellipse}", "-blur", f"0x{blur}", ")", "-alpha", "off", "-compose", "copy_opacity",
        "-composite", "-channel", "A", "-evaluate", "multiply", alpha, "+channel", ")", "-compose", "screen", "-composite"]
    stars = lambda seed, share, size, blur, gain: [
        "(", "-size", "1920x1080", "xc:black", "-seed", seed, "+noise", "Random", "-channel", "G", "-separate",
        "+channel", "-threshold", share, "-morphology", "Dilate", f"Disk:{size}", "-blur", f"0x{blur}",
        "-evaluate", "multiply", gain, ")", "-compose", "screen", "-composite"]
    sh("magick", "-depth", "16", "-size", "1920x1080", "gradient:#1a2e5a-#060a16",
       *glow("#3fe0c8", "700,430 820,105 -6,366", 110, "0.95"),
       *glow("#8a78ff", "1290,330 560,80 0,360", 100, "0.85"),
       *stars("7", "99.9%", 0.6, 0.6, "0.85"), *stars("3", "99.985%", 1.3, 1.3, "1"),
       # the ground darkens, and a little grain keeps the glow from banding
       "(", "-size", "1920x1080", "gradient:white-black", "-level", "0%,300%", "+level", "35%,100%", ")",
       "-compose", "multiply", "-composite", "-attenuate", "0.3", "+noise", "Gaussian", "-depth", "8",
       "-quality", "90", str(out))


def mode_palette(m):
    """a mode's colours, in the shape palette() gives"""
    c = dict(FALLBACK)
    c.update({k: v.lstrip("#") for k, v in m.get("palette", {}).items()})
    c["ansi"] = [x.lstrip("#") for x in m["ansi"]] if len(m.get("ansi", [])) == 16 else ansi(c)
    return c


def apply(s, apps=True):
    if not Path(s["wallpaper"]).is_file():
        s["wallpaper"] = DEFAULTS["wallpaper"]
        if not Path(s["wallpaper"]).is_file():
            night_sky(Path(s["wallpaper"]))
    m = mode(s)
    c = mode_palette(m) if m else palette(s["wallpaper"], s["scheme"])
    shell(s, c)
    if apps and active():
        skip = set(m.get("skip", [])) if m else set()
        cursor(s, m)
        aro(c)
        hyprland(c)
        niri(c)
        wallpaper(s)
        foot(c)
        gtk(c)
        dark(c)
        fuzzel(c, m.get("yoru") if m else None)
        swaylock(c)
        btop(c)
        cava(c)
        starship(c)
        fastfetch(c, s, m)
        if "firefox" not in skip:
            firefox(s, c)
    return c


def hooks(m, when):
    """a mode's own commands for being turned on or off (in the background: one can be slow)"""
    for cmd in m.get("hooks", {}).get(when, []):
        subprocess.Popen(["sh", "-c", cmd], cwd=m["dir"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def set_mode(s, name):
    """the appearance.mode setting, the mode's hooks, its first wallpaper (the one from
    before kept for later), and everything applied again"""
    old = mode(s)
    new = mode_dir(name) if name not in ("", "off", "none") else None
    if name not in ("", "off", "none") and not new:
        print(f"yoru: no mode {name} (a folder with a mode.json, in {MODES} or by path)", file=sys.stderr)
        return 1
    try:
        cfg = json.loads(SETTINGS.read_text())
    except (OSError, ValueError):
        cfg = {}
    cfg.setdefault("appearance", {})["mode"] = name if new else ""
    write(SETTINGS, json.dumps(cfg, indent=4) + "\n")
    if old:
        hooks(old, "off")
    s = state()
    m = mode(s)
    if m:
        if not old:
            s["before_mode"] = s["wallpaper"]
        ws = walls(s)
        first = os.path.expanduser(m.get("pictures", {}).get("first", ""))
        if first and not os.path.isabs(first) and m["walls"]:
            first = os.path.join(m["walls"], first)
        if ws and s["wallpaper"] not in ws:
            s["wallpaper"] = str(Path(first).resolve()) if first and Path(first).is_file() else ws[0]
        hooks(m, "on")
    elif s.get("before_mode"):
        s["wallpaper"] = s.pop("before_mode")
    save_state(s)
    apply(s)
    return 0


# lyrics
LYRICS = CACHE / "lyrics"
# what videos and fan uploads add to a title that the song itself doesn't have
NOISE = re.compile(r"\s*[\[(][^\])]*(official|video|audio|lyric|visuali[sz]er|mv|hd|4k|remaster|slowed|sped|nightcore|reverb|speed)[^\])]*[\])]", re.I)
SPEED = re.compile(r"slowed|sped ?up|speed ?up|nightcore", re.I)


def lrc(text):
    """[mm:ss.xx] lines → [[seconds, line], …], blank lines kept as breathing room"""
    out = []
    for raw in text.splitlines():
        stamps = re.findall(r"\[(\d+):(\d+(?:\.\d+)?)\]", raw)
        line = re.sub(r"\[[^\]]*\]", "", raw).strip()
        for m, sec in stamps:
            out.append([round(int(m) * 60 + float(sec), 2), line])
    return sorted(out, key=lambda x: x[0])


def lyrics(title, artist, length):
    """synced lyrics for what's playing. mpv names YouTube uploads "Artist - Title
    [Official Video]" with itself as the artist, so that gets untangled first.
    YouTube Music gives romanised or translated names that lrclib files under
    other artists, so the last try is the title alone, kept only when its length
    matches. Nightcore and slowed uploads change the tempo: the original's
    timings are stretched to this version's length. Misses are remembered for a
    day; when lrclib couldn't be reached (it's often busy) nothing is remembered
    and None comes back, so the shell can ask again."""
    import time
    import urllib.error
    import urllib.parse
    import urllib.request
    LYRICS.mkdir(parents=True, exist_ok=True)
    f = LYRICS / (hashlib.sha1(f"{title}\n{artist}".encode()).hexdigest()[:16] + ".json")
    try:
        cached = json.loads(f.read_text())
        if cached["lines"] or time.time() - cached["at"] < 86400:
            return cached["lines"]
    except (OSError, ValueError, KeyError):
        pass

    fast = bool(SPEED.search(title))
    # downloads keep their file name: an extension, and yt-dlp's [video id]
    title = re.sub(r"\.(webm|mkv|mp4|m4a|opus|ogg|mp3|flac|wav)$", "", title, flags=re.I)
    title = re.sub(r"\s*\[[A-Za-z0-9_-]{11}\]", "", title)
    t, a = NOISE.sub("", title).strip(), artist.strip()
    if a.lower() in ("", "mpv", "unknown", "unknown artist") or " - " in t:
        if " - " in t:
            a, t = (x.strip() for x in t.split(" - ", 1))
            t = NOISE.sub("", t).strip()
    a = re.sub(r"\s*-\s*topic$", "", a, flags=re.I)
    # "Nightcore - Song" names the tempo, not who sang it
    if SPEED.fullmatch(a):
        a = ""
    # the title alone, without "(feat. …)" and the like, for the last try
    bare = re.sub(r"\s*[\[(][^\])]*[\])]", "", t).strip() or t
    timed = bool(length) and not fast
    q = urllib.parse.quote
    # (url, whether a hit has to match the length to count)
    urls = [(f"https://lrclib.net/api/get?track_name={q(t)}&artist_name={q(a)}&duration={int(length)}", False)] if timed else []
    urls += [(f"https://lrclib.net/api/search?track_name={q(t)}&artist_name={q(a)}", False),
             (f"https://lrclib.net/api/search?q={q(t + ' ' + a)}", False)]
    if length:
        urls.append((f"https://lrclib.net/api/search?track_name={q(bare)}", True))

    def off(hit):
        return abs(float(hit.get("duration") or 0) - float(length))

    def near(hit):
        # a sped-up or slowed version runs somewhere between 0.6 and 1.6 times as long
        if timed:
            return off(hit) <= 3
        return 0.6 <= float(length) / float(hit.get("duration") or 1e9) <= 1.6

    def ask(url):
        """lrclib's answer, None for "not found", or "busy" (429, 5xx, no network): asked twice"""
        for attempt in range(2):
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "yoru (a quickshell rice)"})
                with urllib.request.urlopen(req, timeout=8) as r:
                    return json.loads(r.read())
            except urllib.error.HTTPError as e:
                if e.code == 404:
                    return None
            except Exception:
                pass
            if not attempt:
                time.sleep(1.5)
        return "busy"

    found, failed = None, False
    for url, strict in urls:
        # the title alone can find another artist's song of the same name and length
        # ("Call Me Up": K-391's and Patrick Baker's), so it's only asked once the
        # better questions have really been answered "no"
        if strict and failed:
            break
        d = ask(url)
        if d == "busy":
            failed = True
            continue
        if d is None:
            continue
        hits = [h for h in (d if isinstance(d, list) else [d]) if h and h.get("syncedLyrics")]
        if timed:
            # the same song in another edit or another language runs longer or shorter
            hits.sort(key=off)
        if strict:
            hits = [h for h in hits if near(h)]
        if hits:
            found = hits[0]
            break
    if not found and failed:
        return None
    lines = lrc(found["syncedLyrics"]) if found else []
    if lines and fast and length and found.get("duration"):
        k = float(length) / float(found["duration"])
        lines = [[round(sec * k, 2), line] for sec, line in lines]
    write(f, json.dumps({"at": time.time(), "lines": lines}))
    return lines


def fetch(s, source, search):
    """a random safe-for-work wallpaper of at least 1920x1080 from wallhaven.cc or
    konachan.net (end-4's Konachan button), saved under its site and id so a
    second pick of the same one isn't downloaded twice. Returns the file."""
    import urllib.parse
    import urllib.request

    def get(url):
        req = urllib.request.Request(url, headers={"User-Agent": "yoru (a quickshell rice)"})
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.read()

    q = urllib.parse.quote
    if source == "konachan":
        tags = " ".join(["rating:safe", "order:random", "width:>=1920", "height:>=1080"] + search.split())
        posts = json.loads(get(f"https://konachan.net/post.json?limit=1&tags={q(tags)}"))
        if not posts:
            raise LookupError(f"nothing on konachan for \"{search}\"")
        url, name = posts[0]["file_url"], f"konachan-{posts[0]['id']}"
    else:
        found = json.loads(get("https://wallhaven.cc/api/v1/search?sorting=random&purity=100&categories=111"
                               f"&atleast=1920x1080&ratios=16x9,16x10&q={q(search)}"))["data"]
        if not found:
            raise LookupError(f"nothing on wallhaven for \"{search}\"")
        url, name = found[0]["path"], f"wallhaven-{found[0]['id']}"
    ext = Path(urllib.parse.urlparse(url).path).suffix.lower()
    folder = Path(os.path.expanduser(s.get("online", {}).get("folder") or "~/Pictures/Wallpapers"))
    out = folder / (name + (ext if ext in IMAGES else ".jpg"))
    if not out.exists():
        folder.mkdir(parents=True, exist_ok=True)
        tmp = out.with_name(out.name + ".part")
        tmp.write_bytes(get(url))
        tmp.replace(out)
    return str(out)


def main():
    args = sys.argv[1:] or ["apply"]
    s = state()
    cmd = args[0]
    if cmd == "apply":
        apply(s)
    elif cmd == "wall" and len(args) > 1:
        # from the shell, for what skwd applied itself: only the colours are left to do
        s["skwd_has"] = "--from-skwd" in args
        args = [a for a in args if a != "--from-skwd"]
        target = args[1]
        if target == "time" and len(args) > 2:
            fits = walls_for(s, args[2])
            if not fits:
                return 1
            if "--keep" in args and s["wallpaper"] in fits:
                return 0
            import random
            target = random.choice([w for w in fits if w != s["wallpaper"]] or fits)
        elif target == "fetch":
            o = s.get("online", {})
            source = args[2] if len(args) > 2 else o.get("source") or "wallhaven"
            search = " ".join(args[3:]) if len(args) > 3 else o.get("search") or ""
            try:
                target = fetch(s, source, search)
            except OSError as e:
                print(f"yoru: couldn't reach {source} ({getattr(e, 'reason', e)})", file=sys.stderr)
                return 1
            except Exception as e:
                print(f"yoru: {e}", file=sys.stderr)
                return 1
            print(target)
        elif target in ("next", "prev", "random"):
            ws = walls(s)
            if not ws:
                return 1
            i = ws.index(s["wallpaper"]) if s["wallpaper"] in ws else -1
            if target == "random":
                import random
                target = random.choice([w for w in ws if w != s["wallpaper"]] or ws)
            else:
                target = ws[(i + (1 if target == "next" else -1)) % len(ws)]
        target = str(Path(os.path.expanduser(target)).resolve())
        if not Path(target).is_file():
            print(f"yoru: no such file: {target}", file=sys.stderr)
            return 1
        s["wallpaper"] = target
        save_state(s)
        if s["backend"] == "skwd" and not s["skwd_has"]:
            skwd_apply(target, wait=False)
            s["skwd_has"] = True
        apply(s)
    elif cmd == "walls":
        print(json.dumps(walls_json(s)))
    elif cmd == "timeline" and len(args) > 1:
        # worked out once per video, then handed to the shell if it's still the wallpaper
        timeline(args[1], s["scheme"])
        if s["wallpaper"] == args[1]:
            shell(s, palette(args[1], s["scheme"]))
    elif cmd == "art" and len(args) > 1:
        # a palette from album art, for the shell while the track plays
        c = art_palette(args[1], s["scheme"])
        if not c:
            return 1
        print(json.dumps(c))
    elif cmd == "lyrics" and len(args) > 2:
        print(json.dumps(lyrics(args[1], args[2], float(args[3]) if len(args) > 3 and args[3] else 0)))
    elif cmd == "restore":
        apply(s, apps=False)
        wallpaper(s)
    elif cmd == "skwd" and len(args) > 1:
        if args[1] == "get":
            print(json.dumps(skwd_get()))
        elif args[1] == "set" and len(args) > 3 and len(args) % 2 == 0:
            skwd_set(list(zip(args[2::2], args[3::2])))
        elif args[1] == "follow" and len(args) > 3:
            kind, path = args[2], args[3]
            f = skwd_scene_still(path) if kind == "we" else path
            if not f or not Path(f).is_file():
                return 1
            # one yoru sent there itself comes back as an event too: already done
            if str(Path(f).resolve()) == s["wallpaper"]:
                return 0
            s["wallpaper"] = str(Path(f).resolve())
            s["skwd_has"] = True
            save_state(s)
            apply(s)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    elif cmd == "backend":
        if len(args) < 2:
            print(s["backend"])
        else:
            return set_backend(s, args[1])
    elif cmd == "status":
        print(s["wallpaper"])
    elif cmd == "mode":
        if len(args) < 2:
            print(json.dumps({"current": s.get("mode", ""), "modes": modes()}))
        else:
            return set_mode(s, args[1])
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
