#!/usr/bin/env python3
"""yoru - a night rice for aro, Hyprland and niri: a palette from the wallpaper, in every app.

    yoru                    apply the current wallpaper's palette everywhere
    yoru wall FILE          a new wallpaper (image or video): palette, apps, shell
    yoru wall next|prev|random   another one from the wallpaper folders
    yoru wall time PERIOD [--keep]   one that suits dawn, day, evening or night: from that
                                 period's folder if the settings give one, else by brightness;
                                 --keep leaves the current one if it already suits
    yoru wall fetch [SOURCE] [SEARCH]   a new one from the internet (wallhaven or konachan,
                                 safe-for-work only), saved to the download folder
    yoru walls              every wallpaper as JSON, with thumbnails (the picker reads this)
    yoru timeline FILE      a video's colours across its loop (yoru starts it itself)
    yoru art URL            a palette from album art, as JSON (the shell uses it while music plays)
    yoru lyrics TITLE ARTIST [SECONDS]   synced lyrics from lrclib.net, as JSON [[seconds, line], …]
                                         (null when lrclib couldn't be reached: nothing cached, ask again)
    yoru restore            the palette back at login (the compositor's autostart runs it)
    yoru status             the current wallpaper
    yoru mode [NAME|off]    a mode: a whole look from a folder instead of the wallpaper's palette
                            (its colours, type, shapes, wallpapers, cursor; see "Modes" below).
                            No argument: the modes there are, as JSON
    yoru backend [yoru|skwd]   what draws the wallpaper: the shell itself, or skwd-wall v2's
                            daemon (skwd-walld; yoru still takes the colours, and follows what
                            skwd's own picker applies). No argument: the current one
    yoru skwd get           skwd-wall's settings yoru shows (transition, sound, power, rotation), as JSON
    yoru skwd set PATH VALUE [PATH VALUE…]   skwd's settings (dotted paths in its config.json; VALUE as JSON)
    yoru skwd follow TYPE PATH   take the colours of what skwd just applied (the shell runs this)

Modes: a folder with a mode.json, named by its folder in ~/.config/yoru/modes/
(a link to it is enough) or given by path. mode.json holds "palette" (Material
roles, as matugen gives them), "light", "ansi" (16 terminal colours, optional),
"cursor", "fastfetch_logo", "pictures": {"walls": folder, "first": the one to start on}, "hooks": {"on": [...],
"off": [...]} (commands run when the mode is turned on and off), "skip" (apps the
mode dresses itself, e.g. ["firefox"]), and "yoru": what the shell draws with
(font, mono, radiusScale, border, borderColour, shadow "hard", island "paper",
cardLook). The setting is appearance.mode; the wallpaper from before is kept and
put back when the mode goes off.

State is ~/.config/yoru/yoru.json; the palette the shell reads is
~/.cache/yoru/palette.json. Apps are re-themed too, Hyprland and niri borders
included (yoru-colors.lua/.conf/.kdl); on aro, a rice switcher can hold that off
by writing another name to ~/.local/state/rice/current.
"""

import colorsys
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config"
CACHE = HOME / ".cache/yoru"
STATE = CONF / "yoru/yoru.json"
SETTINGS = CONF / "yoru/config.json"        # the settings window's file
RICE = HOME / ".local/state/rice/current"
MODES = CONF / "yoru/modes"
os.environ["PATH"] = f"{HOME}/.local/bin:{os.environ.get('PATH', '')}"

DEFAULTS = {
    "wallpaper": str(HOME / "Pictures/yoru/yoru-night.jpg"),     # drawn by night_sky() when missing
    "dirs": [str(HOME / "Pictures/yoru"), str(HOME / "Pictures/Wallpapers")],
    "scheme": "scheme-tonal-spot",
    "cursor": "Bibata-Modern-Ice",
}
IMAGES = {".jpg", ".jpeg", ".png", ".webp", ".bmp"}
VIDEOS = {".mp4", ".webm", ".mkv", ".mov", ".gif"}

# a night sky, for when matugen can't run
FALLBACK = {
    "background": "0f1218", "surface": "0f1218", "surface_container_lowest": "0a0d12",
    "surface_container_low": "171b22", "surface_container": "1b2028", "surface_container_high": "262a33",
    "surface_container_highest": "30353e", "on_surface": "e0e2ec", "on_surface_variant": "c3c6d1",
    "outline": "8d909b", "outline_variant": "434751", "primary": "a9c7ff", "on_primary": "0b305f",
    "primary_container": "284777", "on_primary_container": "d6e3ff", "secondary": "bdc7dc",
    "secondary_container": "3e4759", "on_secondary_container": "d9e3f8", "tertiary": "dcbce1",
    "tertiary_container": "573e5c", "on_tertiary_container": "f9d8fe", "error": "ffb4ab",
    "on_error": "690005", "scrim": "000000",
}


def sh(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def claim(path):
    """before yoru first writes over a whole config file it didn't write
    (fuzzel's, swaylock's), the owner's copy is kept as NAME.pre-yoru"""
    try:
        old = path.read_text()
    except OSError:
        return
    keep = path.with_name(path.name + ".pre-yoru")
    if "generated by yoru" not in old and not keep.exists():
        shutil.copy2(path, keep)


def write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".yoru-tmp")
    tmp.write_text(text)
    tmp.replace(path)


def state():
    s = dict(DEFAULTS)
    try:
        s.update(json.loads(STATE.read_text()))
    except (OSError, ValueError):
        pass
    # the settings window owns the scheme and the folders
    try:
        cfg = json.loads(SETTINGS.read_text())
        s["scheme"] = cfg.get("appearance", {}).get("scheme") or s["scheme"]
        s["dirs"] = cfg.get("wallpaper", {}).get("dirs") or s["dirs"]
        s["timeDirs"] = cfg.get("wallpaper", {}).get("timeDirs") or {}
        s["online"] = cfg.get("wallpaper", {}).get("online") or {}
        s["mode"] = cfg.get("appearance", {}).get("mode") or ""
        s["backend"] = cfg.get("wallpaper", {}).get("backend") or "yoru"
    except (OSError, ValueError):
        pass
    m = mode(s)
    if m and m.get("walls"):
        s["dirs"] = [m["walls"]]
    return s


def mode_dir(name):
    """a mode's folder: by name in ~/.config/yoru/modes, or a path"""
    if not name:
        return None
    p = Path(os.path.expanduser(name))
    if not p.is_absolute():
        p = MODES / name
    return p if (p / "mode.json").is_file() else None


def mode(s):
    """the mode the settings name, read from its mode.json; None without one"""
    d = mode_dir(s.get("mode", ""))
    if not d:
        return None
    try:
        m = json.loads((d / "mode.json").read_text())
    except (OSError, ValueError):
        return None
    m["dir"] = str(d)
    m["walls"] = os.path.expanduser(m.get("pictures", {}).get("walls", "")) or None
    return m


def modes():
    out = []
    for d in sorted(MODES.glob("*")) if MODES.is_dir() else []:
        try:
            m = json.loads((d / "mode.json").read_text())
        except (OSError, ValueError):
            continue
        out.append({"name": d.name, "description": m.get("description", ""), "path": str(d.resolve())})
    return out


def save_state(s):
    keep = {"wallpaper": s["wallpaper"]}
    for k in ("before_mode", "fastfetch_logo"):
        if s.get(k):
            keep[k] = s[k]
    write(STATE, json.dumps(keep, indent=2) + "\n")


def compositor():
    """aro, hyprland or niri: whichever this runs under ("" outside all of them,
    as from the installer on a TTY)"""
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return "hyprland"
    if os.environ.get("NIRI_SOCKET"):
        return "niri"
    if os.environ.get("ARO_SOCKET") or os.environ.get("XDG_CURRENT_DESKTOP", "").lower() == "aro":
        return "aro"
    return ""


def active():
    """whether apps take yoru's colours: on aro only while ~/.local/state/rice/current
    says yoru (when another rice is on, it keeps its own look); without that file, always"""
    if compositor() != "aro":
        return True
    try:
        return RICE.read_text().strip() == "yoru"
    except OSError:
        return True


def is_video(f):
    return Path(f).suffix.lower() in VIDEOS


# wallpapers
def key(f):
    p = Path(f)
    st = p.stat()
    return hashlib.sha1(f"{p.resolve()}:{st.st_mtime_ns}:{st.st_size}".encode()).hexdigest()[:16]


def still(f):
    """an image of the wallpaper: itself, or a video's frame"""
    if not is_video(f):
        return f
    out = CACHE / "frames" / (key(f) + ".jpg")
    if not out.exists():
        out.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-ss", "2", "-i", f, "-frames:v", "1",
                        "-q:v", "3", str(out)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return str(out) if out.exists() else ""


def thumb(f):
    out = CACHE / "thumbs" / (key(f) + ".jpg")
    if not out.exists():
        src = still(f)
        if not src:
            return ""
        out.parent.mkdir(parents=True, exist_ok=True)
        sh("magick", src + "[0]", "-resize", "480x270^", "-gravity", "center", "-extent", "480x270",
           "-quality", "86", str(out))
    return str(out) if out.exists() else ""


# the picker's colour filter: which hues a wallpaper is mostly made of and how
# light it is, read once from its thumbnail (most walls are named
# wallhaven-xxxxxx, so their names are no use for finding one)
HUES = [(15, "red"), (45, "orange"), (70, "yellow"), (160, "green"), (200, "cyan"),
        (255, "blue"), (290, "purple"), (345, "pink"), (360, "red")]


def colours(t, cache):
    k = Path(t).name
    if k not in cache:
        px = subprocess.run(["magick", t, "-resize", "32x18!", "-depth", "8", "rgb:-"],
                            capture_output=True).stdout if t else b""
        weight, light = {}, 0.0
        n = len(px) // 3
        for i in range(n):
            h, l, s = colorsys.rgb_to_hls(px[3 * i] / 255, px[3 * i + 1] / 255, px[3 * i + 2] / 255)
            light += l
            # greys and near-blacks say nothing about hue
            w = s * (1 - abs(2 * l - 1))
            if w > 0.12:
                name = next(nm for top, nm in HUES if h * 360 < top)
                weight[name] = weight.get(name, 0) + w
        total = sum(weight.values())
        names = sorted(weight, key=weight.get, reverse=True)
        cache[k] = {"colours": [nm for nm in names[:3] if weight[nm] > 0.2 * total] if total > n * 0.04 else [],
                    "light": round(light / n, 3) if n else 0.5}
    return cache[k]


def walls_json(s):
    path = CACHE / "colours.json"
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    out = []
    for f in walls(s):
        t = thumb(f)
        out.append(dict(colours(t, cache), path=f, thumb=t, video=is_video(f), name=Path(f).stem,
                        added=int(Path(f).stat().st_mtime)))
    write(path, json.dumps(cache))
    return out


def walls(s):
    found = []
    for d in s["dirs"]:
        d = Path(os.path.expanduser(d))
        if not d.is_dir():
            continue
        for f in sorted(d.iterdir(), key=lambda p: p.name.lower()):
            # a mode's folder may hold links to pictures kept elsewhere
            if f.is_file() and f.suffix.lower() in IMAGES | VIDEOS and str(f.resolve()) not in found:
                found.append(str(f.resolve()))
    return found


# how bright a wallpaper is, 0..1, measured once on a small copy
def brightness(f, cache):
    k = key(f)
    if k not in cache:
        src = still(f)
        out = subprocess.run(["magick", src + "[0]", "-resize", "64x64!", "-colorspace", "gray", "-format", "%[fx:mean]", "info:"],
                             capture_output=True, text=True).stdout if src else ""
        try:
            cache[k] = round(float(out), 4)
        except (TypeError, ValueError):
            cache[k] = 0.5
    return cache[k]


# the wallpapers that suit a time of day: that period's own folder, or else
# the darkest ones at night, the brightest by day, the middle ones at dawn
# and in the evening (the bands overlap, so each has a choice)
BANDS = {"night": (0, 0.45), "dawn": (0.3, 0.75), "evening": (0.25, 0.7), "day": (0.55, 1.0)}


def wall_brightness(f):
    path = CACHE / "brightness.json"
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    b = brightness(f, cache)
    write(path, json.dumps(cache))
    return b


def walls_for(s, period):
    own = s.get("timeDirs", {}).get(period, "")
    if own:
        found = walls(dict(s, dirs=[own]))
        if found:
            return found
    ws = walls(s)
    if len(ws) < 3:
        return ws
    path = CACHE / "brightness.json"
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    ranked = sorted(ws, key=lambda f: brightness(f, cache))
    write(path, json.dumps(cache))
    lo, hi = BANDS.get(period, (0, 1))
    n = len(ranked)
    return ranked[int(lo * n):max(int(lo * n) + 1, round(hi * n))]


# palette
def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def rgb_hex(r, g, b):
    return "".join(f"{round(max(0, min(1, c)) * 255):02x}" for c in (r, g, b))


def hls(hue, light, sat):
    return rgb_hex(*colorsys.hls_to_rgb(hue % 1, light, sat))


def light(c):
    """whether a palette is a light one: dark text on a bright surface"""
    r, g, b = hex_rgb(c["surface"])
    return 0.299 * r + 0.587 * g + 0.114 * b > 0.5


def ansi(c):
    """16 terminal colours that belong to the wallpaper: fixed hues, nudged toward the primary
    (deeper on a light palette, so they read on its pale background)"""
    ph, pl, ps = colorsys.rgb_to_hls(*hex_rgb(c["primary"]))
    pull = 0.06
    lo, hi = (0.36, 0.44) if light(c) else (0.72, 0.80)

    def tint(h):
        d = ((ph - h + 0.5) % 1) - 0.5
        return h + d * pull

    hues = {1: 0.0, 2: 0.36, 3: 0.12, 4: 0.6, 5: 0.82, 6: 0.5}
    sat = 0.55 + min(ps, 0.6) * 0.3
    out = [c["surface_container_high"]] + [""] * 15
    for i, h in hues.items():
        out[i] = hls(tint(h), lo, sat)
        out[i + 8] = hls(tint(h), hi, sat)
    out[4], out[12] = c["primary"], c["primary_fixed"] if "primary_fixed" in c else hls(ph, 0.85, ps)
    out[7] = c["on_surface_variant"]
    out[8] = c["outline"]
    out[15] = c["on_surface"]
    return out


# video wallpapers: frames across the loop
SHELL_ROLES = ("surface", "surface_container_lowest", "surface_container_low", "surface_container",
               "surface_container_high", "surface_container_highest", "on_surface", "on_surface_variant",
               "outline", "outline_variant", "primary", "on_primary", "primary_container", "on_primary_container",
               "secondary", "secondary_container", "on_secondary_container", "tertiary", "tertiary_container",
               "on_tertiary_container", "error")


def frames(f):
    """a small frame every couple of seconds across the video, at most 30: [(seconds, path)]"""
    d = CACHE / "frames" / key(f)
    meta = d / "step"
    if not meta.exists():
        r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", f],
                           capture_output=True, text=True)
        try:
            dur = float(r.stdout.strip())
        except ValueError:
            return []
        step = max(2.0, dur / 30)
        d.mkdir(parents=True, exist_ok=True)
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", f, "-vf", f"fps=1/{step},scale=256:-2",
                        "-q:v", "4", str(d / "%03d.jpg")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        meta.write_text(str(step))
    step = float(meta.read_text())
    return [((int(p.stem) - 1) * step, str(p)) for p in sorted(d.glob("[0-9]*.jpg"))]


def matugen(img, scheme):
    r = subprocess.run(["matugen", "image", img, "-m", "dark", "-t", scheme, "--json", "hex",
                        "--dry-run", "--prefer", "saturation"], capture_output=True, text=True)
    try:
        return {k: v["dark"]["color"].lstrip("#") for k, v in json.loads(r.stdout)["colors"].items()}
    except (ValueError, KeyError):
        return None


def mosaic(f):
    """every sampled frame in one picture, so the palette speaks for the whole loop"""
    out = CACHE / "frames" / key(f) / "mosaic.jpg"
    if not out.exists():
        fs = [p for _, p in frames(f)]
        if not fs:
            return ""
        sh("magick", "montage", *fs, "-tile", "6x", "-geometry", "+0+0", str(out))
    return str(out) if out.exists() else ""


def timeline_file(f, scheme):
    return CACHE / "timelines" / f"{key(f)}-{scheme}.json"


def timeline(f, scheme):
    """a palette for each sampled moment, for the shell to drift through as the video plays"""
    out = timeline_file(f, scheme)
    if out.exists():
        try:
            return json.loads(out.read_text())
        except ValueError:
            pass
    steps = []
    for t, img in frames(f):
        c = matugen(img, scheme)
        if c:
            steps.append({"t": t, "c": {k: c[k] for k in SHELL_ROLES if k in c}})
    write(out, json.dumps(steps))
    return steps


def palette(f, scheme):
    src = (mosaic(f) or still(f)) if is_video(f) else still(f)
    cached = CACHE / "palettes" / f"{key(f)}-{scheme}{'-loop' if is_video(f) else ''}.json"
    if cached.exists():
        try:
            return json.loads(cached.read_text())
        except ValueError:
            pass
    c = dict(FALLBACK)
    if src and shutil.which("matugen"):
        r = subprocess.run(["matugen", "image", src, "-m", "dark", "-t", scheme, "--json", "hex",
                            "--dry-run", "--prefer", "saturation"], capture_output=True, text=True)
        try:
            data = json.loads(r.stdout)
            c = {k: v["dark"]["color"].lstrip("#") for k, v in data["colors"].items()}
        except (ValueError, KeyError):
            pass
    c["ansi"] = ansi(c)
    write(cached, json.dumps(c))
    return c


def art_palette(url, scheme):
    """album art (file:// or http) to a palette; downloads and results are cached"""
    h = hashlib.sha1(f"{url}:{scheme}".encode()).hexdigest()[:16]
    out = CACHE / "art" / (h + ".json")
    if out.exists():
        try:
            return json.loads(out.read_text())
        except ValueError:
            pass
    if url.startswith("data:"):
        # mpv hands the embedded cover over inline
        import base64
        img = str(CACHE / "art" / (h + ".img"))
        out.parent.mkdir(parents=True, exist_ok=True)
        try:
            Path(img).write_bytes(base64.b64decode(url.split(",", 1)[1]))
        except (IndexError, ValueError):
            return None
    elif url.startswith("file://"):
        img = url[7:]
    elif url.startswith(("http://", "https://")):
        img = str(CACHE / "art" / (h + ".img"))
        out.parent.mkdir(parents=True, exist_ok=True)
        if subprocess.run(["curl", "-sfL", "-m", "8", "-o", img, url]).returncode != 0:
            return None
    else:
        img = url
    if not Path(img).is_file() or not shutil.which("matugen"):
        return None
    r = subprocess.run(["matugen", "image", img, "-m", "dark", "-t", scheme, "--json", "hex",
                        "--dry-run", "--prefer", "saturation"], capture_output=True, text=True)
    try:
        c = {k: v["dark"]["color"].lstrip("#") for k, v in json.loads(r.stdout)["colors"].items()}
    except (ValueError, KeyError):
        return None
    write(out, json.dumps(c))
    return c


# apps
def shell(s, c):
    """the palette the quickshell config watches; a video's colour timeline goes
    with it once worked out (in the background the first time: `yoru timeline`)"""
    f = s["wallpaper"]
    data = dict(c, wallpaper=f, still=still(f), video=is_video(f), bright=wall_brightness(f))
    m = mode(s)
    if m:
        data["mode"] = dict(m.get("yoru", {}), name=Path(m["dir"]).name, light=light(c))
    if is_video(f):
        tl = timeline_file(f, s["scheme"])
        if tl.exists():
            data["timeline"] = json.loads(tl.read_text())
        else:
            subprocess.Popen(["yoru", "timeline", f], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
    write(CACHE / "palette.json", json.dumps(data, indent=2) + "\n")


ARO = {
    "background": lambda c: c["surface"] + "ff",
    "frame": lambda c: c["surface_container"] + "ff",
    "frame_focus": lambda c: c["surface_container_high"] + "ff",
    "border_color": lambda c: c["surface_container_highest"] + "ff",
    "accent": lambda c: c["primary"] + "ff",
    "accent_soft": lambda c: c["primary"] + "40",
    "text": lambda c: c["on_surface"] + "ff",
    "text_dim": lambda c: c["on_surface_variant"] + "ff",
    "bar_color": lambda c: c["surface_container_lowest"] + "ff",
    "urgent": lambda c: c["error"] + "ff",
    "drop_fill": lambda c: c["primary"] + "1f",
    "drop_line": lambda c: c["primary"] + "cc",
    "notify_color": lambda c: c["surface_container_high"] + "f2",
    "scrim_color": lambda c: c["scrim"] + "8c",
    "overview_tint": lambda c: c["surface_container_lowest"] + "80",
}


def aro(c):
    path = CONF / "aro/config"
    if compositor() != "aro" or not path.exists():
        return
    s = path.read_text()
    for k, val in ARO.items():
        s = re.sub(rf"^(\s*{k}\s*=\s*)(0x|#)?[0-9a-fA-F]{{6,8}}", lambda m: m.group(1) + "0x" + val(c), s, flags=re.M)
    write(path, s)
    sh("aroctl", "reload")



def hyprland(c):
    """the borders and shadow in the wallpaper's colours: yoru-colors.lua for
    0.56's Lua config, yoru-colors.conf for older ones (yoru.lua / yoru.conf
    pull them in)"""
    d = CONF / "hypr"
    if not d.is_dir():
        return
    active, second = c["primary"], c["tertiary"]
    idle, shadow = c["outline_variant"], c["surface_container_lowest"]
    write(d / "yoru-colors.lua", f"""-- written by yoru from the wallpaper; changes with it
hl.config({{
    general = {{
        col = {{
            active_border   = {{ colors = {{ "rgba({active}ee)", "rgba({second}ee)" }}, angle = 45 }},
            inactive_border = "rgba({idle}88)",
        }},
    }},
    decoration = {{ shadow = {{ color = 0xcc{shadow} }} }},
}})
""")
    write(d / "yoru-colors.conf", f"""# written by yoru from the wallpaper; changes with it
general {{
    col.active_border = rgba({active}ee) rgba({second}ee) 45deg
    col.inactive_border = rgba({idle}88)
}}
decoration {{
    shadow {{
        color = rgba({shadow}cc)
    }}
}}
""")
    if compositor() == "hyprland":
        sh("hyprctl", "reload")


def niri(c):
    """the focus ring and borders in the wallpaper's colours (yoru.kdl
    includes this; niri reloads it by itself)"""
    d = CONF / "niri"
    if not d.is_dir():
        return
    write(d / "yoru-colors.kdl", f"""// written by yoru from the wallpaper; changes with it
layout {{
    focus-ring {{
        active-color "#{c["primary"]}"
        inactive-color "#{c["outline_variant"]}"
    }}
    border {{
        active-color "#{c["primary"]}"
        inactive-color "#{c["outline_variant"]}"
    }}
    shadow {{
        color "#{c["surface_container_lowest"]}aa"
    }}
}}
""")


def foot(c):
    a = c["ansi"]
    out = ["# generated by yoru", "", "[colors-dark]",
           f"foreground={c['on_surface']}", f"background={c['surface_container_lowest']}",
           "alpha=1.0" if light(c) else "alpha=0.86", "blur=no" if light(c) else "blur=yes"]
    out += [f"regular{i}={a[i]}" for i in range(8)] + [f"bright{i}={a[i + 8]}" for i in range(8)]
    out += [f"selection-foreground={c['on_primary_container']}", f"selection-background={c['primary_container']}",
            f"cursor={c['on_primary']} {c['primary']}", f"urls={c['tertiary']}",
            f"jump-labels={c['on_primary']} {c['primary']}", ""]
    write(CONF / "foot/themes/yoru", "\n".join(out))
    path = CONF / "foot/foot.ini"
    if path.exists():
        s = re.sub(r"^include=.*themes/\w+$", "include=~/.config/foot/themes/yoru", path.read_text(), flags=re.M)
        write(path, s)
    # recolour the terminals already open
    seq = "".join(f"\033]4;{i};#{a[i]}\033\\" for i in range(16))
    seq += (f"\033]10;#{c['on_surface']}\033\\\033]11;#{c['surface_container_lowest']}\033\\"
            f"\033]12;#{c['primary']}\033\\\033]17;#{c['primary_container']}\033\\"
            f"\033]19;#{c['on_primary_container']}\033\\")
    seq = seq.encode()
    uid = os.getuid()
    for pts in Path("/dev/pts").glob("[0-9]*"):
        try:
            if pts.stat().st_uid != uid:
                continue
            fd = os.open(pts, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
            try:
                os.write(fd, seq)
            finally:
                os.close(fd)
        except OSError:
            pass


def gtk(c):
    css = f"""/* generated by yoru */
@define-color accent_color #{c['primary']};
@define-color accent_bg_color #{c['primary']};
@define-color accent_fg_color #{c['on_primary']};
@define-color destructive_bg_color #{c['error']};
@define-color destructive_fg_color #{c['on_error']};
@define-color error_bg_color #{c['error']};
@define-color error_fg_color #{c['on_error']};
@define-color window_bg_color #{c['surface_container_low']};
@define-color window_fg_color #{c['on_surface']};
@define-color view_bg_color #{c['surface']};
@define-color view_fg_color #{c['on_surface']};
@define-color headerbar_bg_color #{c['surface_container']};
@define-color headerbar_fg_color #{c['on_surface']};
@define-color headerbar_backdrop_color @window_bg_color;
@define-color popover_bg_color #{c['surface_container_high']};
@define-color popover_fg_color #{c['on_surface']};
@define-color card_bg_color #{c['surface_container']};
@define-color card_fg_color #{c['on_surface']};
@define-color dialog_bg_color #{c['surface_container_high']};
@define-color dialog_fg_color #{c['on_surface']};
@define-color sidebar_bg_color #{c['surface_container_low']};
@define-color sidebar_fg_color #{c['on_surface']};
@define-color sidebar_backdrop_color @sidebar_bg_color;
@define-color sidebar_border_color #{c['outline_variant']};
@define-color secondary_sidebar_bg_color #{c['surface_container']};
@define-color secondary_sidebar_fg_color #{c['on_surface']};
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;
"""
    root = f""":root {{
    --accent-color: #{c['primary']};
    --accent-bg-color: #{c['primary']};
    --accent-fg-color: #{c['on_primary']};
    --window-bg-color: #{c['surface_container_low']};
    --window-fg-color: #{c['on_surface']};
    --view-bg-color: #{c['surface']};
    --view-fg-color: #{c['on_surface']};
    --headerbar-bg-color: #{c['surface_container']};
    --headerbar-fg-color: #{c['on_surface']};
    --popover-bg-color: #{c['surface_container_high']};
    --popover-fg-color: #{c['on_surface']};
    --card-bg-color: #{c['surface_container']};
    --card-fg-color: #{c['on_surface']};
    --dialog-bg-color: #{c['surface_container_high']};
    --dialog-fg-color: #{c['on_surface']};
    --sidebar-bg-color: #{c['surface_container_low']};
    --sidebar-fg-color: #{c['on_surface']};
    --window-radius: 16px;
}}
"""
    write(CONF / "gtk-3.0/yoru.css", css)
    write(CONF / "gtk-4.0/yoru.css", css + root)
    # the user's own gtk.css is kept once, as gtk.css.pre-yoru, and never overwritten
    for d in ("gtk-3.0", "gtk-4.0"):
        f = CONF / d / "gtk.css"
        old = f.with_name("gtk.css.pre-yoru")
        if f.exists() and "yoru" not in f.read_text() and not old.exists():
            f.replace(old)
        write(f, '/* generated by yoru; your old gtk.css is gtk.css.pre-yoru */\n@import url("yoru.css");\n')


def fuzzel(c, look=None):
    look = look or {}
    font = look.get("font", "Geist")
    radius = round(22 * look.get("radiusScale", 1))
    border = round(look.get("border", 1))
    edge = look.get("borderColour", c["outline_variant"])
    claim(CONF / "fuzzel/fuzzel.ini")
    write(CONF / "fuzzel/fuzzel.ini", f"""# generated by yoru

[main]
font={font}:size=11
icon-theme={"Papirus" if light(c) else "Papirus-Dark"}
width=36
lines=9
horizontal-pad=20
vertical-pad=16
inner-pad=10
line-height=26
prompt="  "

[colors]
background={c['surface_container']}f2
text={c['on_surface_variant']}ff
prompt={c['primary']}ff
placeholder={c['outline']}ff
input={c['on_surface']}ff
match={c['primary']}ff
selection={c['secondary_container']}ff
selection-text={c['on_secondary_container']}ff
selection-match={c['primary']}ff
counter={c['outline']}ff
border={edge}ff

[border]
width={border}
radius={radius}
selection-radius={round(radius * 0.64)}
""")


