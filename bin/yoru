def btop(c):
    a = c["ansi"]
    keys = {
        "main_bg": "", "main_fg": c["on_surface"], "title": c["on_surface"], "hi_fg": c["primary"],
        "selected_bg": c["secondary_container"], "selected_fg": c["on_secondary_container"],
        "inactive_fg": c["outline"], "proc_misc": c["tertiary"], "graph_text": c["on_surface_variant"],
        "meter_bg": c["surface_container_highest"],
        "cpu_box": c["outline_variant"], "mem_box": c["outline_variant"], "net_box": c["outline_variant"],
        "proc_box": c["outline_variant"], "div_line": c["outline_variant"],
        "temp_start": c["primary"], "temp_mid": c["tertiary"], "temp_end": a[1],
        "cpu_start": c["primary"], "cpu_mid": c["tertiary"], "cpu_end": a[1],
        "free_start": c["primary_container"], "free_mid": c["primary"], "free_end": c["primary"],
        "cached_start": c["secondary_container"], "cached_mid": c["secondary"], "cached_end": c["secondary"],
        "available_start": c["tertiary_container"], "available_mid": c["tertiary"], "available_end": c["tertiary"],
        "used_start": c["primary"], "used_mid": c["tertiary"], "used_end": a[1],
        "download_start": c["primary_container"], "download_mid": c["primary"], "download_end": a[12],
        "upload_start": c["tertiary_container"], "upload_mid": c["tertiary"], "upload_end": a[13],
    }
    body = "\n".join(f'theme[{k}]="{"#" + v if v else ""}"' for k, v in keys.items())
    write(CONF / "btop/themes/yoru.theme", f"# generated by yoru\n\n{body}\n")
    path = CONF / "btop/btop.conf"
    if path.exists():
        write(path, re.sub(r'^color_theme = ".*"$', 'color_theme = "yoru"', path.read_text(), flags=re.M))


