#!/usr/bin/env python3
"""rice - switch aro between your rices.

    rice                show which one is on
    rice yoru | kon     switch to it
    rice toggle         the other one

Each rice keeps its own aro config: the live ~/.config/aro/config belongs to
the rice that is on, and the other waits as ~/.config/aro/config.<name>.
Whatever you edit in the live config goes with it when you switch away.
"""

import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config"
ARO = CONF / "aro/config"
STATE = HOME / ".local/state/rice"
os.environ["PATH"] = f"{HOME}/.local/bin:{os.environ.get('PATH', '')}"
RICES = ("kon", "yoru")


def run(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def spawn(*cmd):
    # outlive this script: aro started it through sh
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def running(pattern):
    return subprocess.run(["pgrep", "-f", pattern], stdout=subprocess.DEVNULL).returncode == 0


def current():
    try:
        name = (STATE / "current").read_text().strip()
        if name in RICES:
            return name
    except OSError:
        pass
    return "yoru" if running("qs -c yoru") else "kon"


# ── what the light kon theme and the dark yoru disagree on ──────────────

GTK_SETTINGS = (CONF / "gtk-3.0/settings.ini", CONF / "gtk-4.0/settings.ini")


def remember_desktop():
    lines = [f"color-scheme={run('gsettings', 'get', 'org.gnome.desktop.interface', 'color-scheme')}",
             f"cursor-theme={run('gsettings', 'get', 'org.gnome.desktop.interface', 'cursor-theme')}"]
    for f in GTK_SETTINGS:
        m = re.search(r"^gtk-application-prefer-dark-theme=(.*)$", f.read_text(), re.M) if f.exists() else None
        if m:
            lines.append(f"{f}={m.group(1)}")
    (STATE / "kon.desktop").write_text("\n".join(lines) + "\n")


def restore_desktop():
    try:
        saved = (STATE / "kon.desktop").read_text().splitlines()
    except OSError:
        return
    for line in saved:
        k, _, v = line.partition("=")
        if k in ("color-scheme", "cursor-theme"):
            run("gsettings", "set", "org.gnome.desktop.interface", k, v.strip("'"))
        elif Path(k).exists():
            f = Path(k)
            f.write_text(re.sub(r"^gtk-application-prefer-dark-theme=.*$", "gtk-application-prefer-dark-theme=" + v,
                                f.read_text(), flags=re.M))


# ── each rice's shell ───────────────────────────────────────────────────

def stop(name):
    if name == "kon":
        run("qs", "kill", "-c", "aroclip")
        run("pkill", "-x", "mako")
    else:
        run("qs", "kill", "-c", "yoru")


def start(name):
    if name == "kon":
        spawn("mako")
        spawn("qs", "-n", "-c", "aroclip", "-d")
        theme = run("kon", "status") or "aero"
        run("kon", theme)                     # every app, the cursor, the wallpaper
        restore_desktop()
    else:
        run("yoru")                           # every app, aro's colours, the wallpaper
        spawn("qs", "-n", "-c", "yoru", "-d")


def switch(target):
    cur = current()
    if cur == target:
        print(f"already {target}")
        return 0
    want = ARO.with_name(f"config.{target}")
    if not want.exists():
        if target == "yoru" and (CONF / "yoru/aro.config").exists():
            shutil.copy(CONF / "yoru/aro.config", want)
        else:
            print(f"rice: no {want} to switch to", file=sys.stderr)
            return 1

    STATE.mkdir(parents=True, exist_ok=True)
    # the first switch ever keeps a copy of how things were
    first = ARO.with_name("config.bak-before-rice")
    if not first.exists():
        shutil.copy(ARO, first)

    if cur == "kon":
        remember_desktop()
    shutil.copy(ARO, ARO.with_name(f"config.{cur}"))
    stop(cur)
    shutil.copy(want, ARO)
    (STATE / "current").write_text(target + "\n")
    run("aroctl", "reload")
    start(target)
    if target == "yoru":
        time.sleep(1.2)
        run("qs", "-c", "yoru", "ipc", "call", "toast", "say", "yoru", "the night rice · mod+ctrl+r goes back to kon")
    print(f"{cur} → {target}")
    return 0


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else "status"
    if arg == "status":
        print(current())
    elif arg == "toggle":
        return switch("kon" if current() == "yoru" else "yoru")
    elif arg in RICES:
        return switch(arg)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
