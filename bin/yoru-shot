#!/bin/sh
# yoru-shot full|area: a screenshot to the clipboard and ~/Pictures/Screenshots,
# shown in the island
set -u
dir=$HOME/Pictures/Screenshots
mkdir -p "$dir"
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png
# the focused output, asked of whichever compositor this is
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	out=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')
elif [ -n "${NIRI_SOCKET:-}" ]; then
	out=$(niri msg -j focused-output | jq -r '.name')
else
	out=$(aroctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | .name')
fi

case ${1:-full} in
full)
	if [ -n "$out" ]; then grim -o "$out" "$file"; else grim "$file"; fi ;;
area)
	accent=$(jq -r '.primary // "a9c7ff"' "$HOME/.cache/yoru/palette.json" 2>/dev/null)
	geo=$(slurp -d -b 00000077 -c "${accent}ff" -s "${accent}22" -w 2) || exit 0
	grim -g "$geo" "$file" ;;
*)
	echo "usage: yoru-shot full|area" >&2; exit 2 ;;
esac

wl-copy --type image/png < "$file"
qs -c yoru ipc call toast shot "$file" >/dev/null 2>&1 || notify-send -i "$file" "Screenshot" "copied to the clipboard"
